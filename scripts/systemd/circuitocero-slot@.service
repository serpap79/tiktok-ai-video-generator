[Unit]
Description=Circuito Cero - slot %i (pauta, guion, render y publicación)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@ROOT@
Environment=PATH=@HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
# El renderizador por defecto es el propio (ffmpeg); el MoneyPrinterTurbo es reserva y
# no necesita estar en pie para que el slot empiece.
ExecStart=@HOME@/.local/bin/uv run agent slot --slot %i
TimeoutStartSec=3h
Nice=5

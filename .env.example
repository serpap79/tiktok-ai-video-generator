# Copie para .env para rodar localmente. Segredos só vivem no .env (git-ignored).
# Sem chave de LLM, o `agent judge` ainda reprova na medida sem gastar token;
# pesquisa, roteiro e narração conferida precisam de pelo menos uma.

# --- LLM (free tiers; ao menos um para produzir) ---
AGENT_GEMINI_API_KEY=
AGENT_GROQ_API_KEY=
# Opcional: destrava o writer no groq (o raciocínio comia o orçamento do JSON).
AGENT_GROQ_REASONING_EFFORT=

# --- OpenRouter (rota principal; endpoint pago, ~$0,01 por vídeo) ---
AGENT_OPENROUTER_API_KEY=

# --- Material visual (cadastro grátis) ---
# O .env herdado do MoneyPrinterTurbo usa PEXELS_API_KEY sem prefixo;
# os dois valem, o com prefixo primeiro.
AGENT_PEXELS_API_KEY=
PEXELS_API_KEY=

# --- Renderizador MoneyPrinterTurbo (reserva; o padrão é o ffmpeg próprio) ---
AGENT_RENDERER_API_KEY=
IMAGEIO_FFMPEG_EXE=

# --- Publicador (TikTok Content Posting API, inbox — sem auditoria) ---
# App em developers.tiktok.com; tokens via `uv run agent tiktok-auth-url`.
AGENT_TIKTOK_CLIENT_KEY=
AGENT_TIKTOK_CLIENT_SECRET=
AGENT_TIKTOK_REDIRECT_URI=
AGENT_TIKTOK_ACCESS_TOKEN=
AGENT_TIKTOK_REFRESH_TOKEN=

# --- Piloto automático (opcional) ---
# Push no celular via ntfy.sh (grátis, sem conta). Vazio = só aviso local.
AGENT_NTFY_TOPIC=
